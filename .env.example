# Copy this file to .env and replace every placeholder locally.
# Never commit or publish the completed .env file.

# Numeric user and group IDs that own the project directory.
# Find the current user's values with: id "$USER"
PUID=1000
PGID=1000

# Any valid tz database name, such as America/New_York or Europe/London.
TZ=Etc/UTC

# Login for the streamed Chromium GUI. Use unique values.
CHROMIUM_GUI_USER=choose-a-username
CHROMIUM_GUI_PASSWORD=choose-a-long-unique-password

# Bearer token for the Scrapling MCP endpoint.
# Generate one with: openssl rand -hex 32
SCRAPLING_MCP_AUTH_TOKEN=replace-with-a-long-random-token
